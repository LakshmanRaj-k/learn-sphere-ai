{
  "version": 2,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/chat", "destination": "/api/index" },
    { "source": "/quiz", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/memory", "destination": "/api/index" }
  ],
  "routes": [
    { "src": "/app/(.*)", "dest": "frontend/app/$1" },
    { "src": "/styles/(.*)", "dest": "frontend/styles/$1" },
    { "src": "/([^/]+\\.html)", "dest": "frontend/$1" },
    { "src": "/", "dest": "frontend/index.html" },
    { "src": "/(.*)", "dest": "frontend/index.html" }
  ]
}
