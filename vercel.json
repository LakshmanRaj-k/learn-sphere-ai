{
  "version": 2,
  "builds": [
    { "src": "frontend/**", "use": "@vercel/static" },
    { "src": "backend/server.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/server.js" },
    { "src": "/chat", "dest": "backend/server.js" },
    { "src": "/quiz", "dest": "backend/server.js" },
    { "src": "/health", "dest": "backend/server.js" },
    { "src": "/memory", "dest": "backend/server.js" },
    { "src": "/app/(.*)", "dest": "frontend/app/$1" },
    { "src": "/styles/(.*)", "dest": "frontend/styles/$1" },
    { "src": "/([^/]+\\.html)", "dest": "frontend/$1" },
    { "src": "/", "dest": "frontend/index.html" },
    { "src": "/(.*)", "dest": "frontend/index.html" }
  ]
}
